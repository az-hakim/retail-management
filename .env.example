# OmniRetail SaaS - Environment Configuration Template

NODE_ENV=production
PORT=3000
APP_BASE_DOMAIN=omnipos.vercel.app

# Database (PostgreSQL with Row Level Security)
# Neon / Supabase / AWS RDS
DATABASE_URL="postgresql://user:password@ep-sample-pool.neon.tech/neondb?sslmode=require"
DATABASE_POOL_MAX=20

# Redis (Caching & Session Store - Upstash / Redis Cloud)
REDIS_URL="redis://default:token@sample.upstash.io:6379"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="super_secret_jwt_access_key_change_me_in_production"
JWT_REFRESH_SECRET="super_secret_jwt_refresh_key_change_me_in_production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Object Storage (S3 / Cloudflare R2 / Vercel Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_sample"
S3_BUCKET="omnipos-retail-assets"
S3_REGION="auto"
S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
S3_ACCESS_KEY="your_s3_key"
S3_SECRET_KEY="your_s3_secret"

# SaaS Billing & Webhooks
BILLING_WEBHOOK_SECRET="whsec_sample_secret"
